# .gitignore for PHP projects

# Composer
/vendor/
/composer.lock

# Environment files
.env
.env.*
.env.local
.env.production

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# IDE / Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.iml

# Node
node_modules/
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock

# Build output
/dist/
/build/
/public/build/

# Temporary files
tmp/
temp/
.cache/

# Uploaded files / storage
uploads/
storage/

# Docker
docker-compose.override.yml

# Secrets and credentials (do NOT commit secrets)
creds.txt
credentials.php
config_local.php
.env.php

# Other
*.sqlite
*.db

